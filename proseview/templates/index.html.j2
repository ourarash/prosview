<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title>Manuscript Dashboard</title>
    <link rel="icon" type="image/png" href="data:image/png;base64,">
    <script id="proseview-bootstrap">
        (function() {
            const storedKey = 'proseview-theme';
            let theme = 'light';
            try {
                // Must stay in step with THEME_ORDER in 00-state.js. This runs
                // before any other script so the theme is set before first
                // paint, so it cannot read THEME_ORDER directly -- a value
                // missing here is silently rejected on load and the reader's
                // choice resets to light. test_themes.py guards the pair.
                const allowed = ['light', 'dark', 'docsify', 'hopscotch',
                                 'graphite-light', 'graphite-dark'];
                const stored = localStorage.getItem(storedKey);
                if (allowed.indexOf(stored) >= 0) {
                    theme = stored;
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (err) {
                theme = 'light';
            }
            document.documentElement.dataset.theme = theme;
        })();
        (function() {
            const storedKey = 'proseview-font';
            // Must stay in step with FONT_ORDER in 00-state.js and the
            // #modalFontSelect options below. This runs before any other
            // script so the font is set before first paint, so it cannot read
            // FONT_ORDER directly -- a value missing here is silently rejected
            // on load and the reader's choice resets to 'reader'.
            const allowed = ['reader', 'literary', 'inter', 'georgia', 'baskerville', 'sans', 'mono'];
            let font = 'reader';
            try {
                const stored = localStorage.getItem(storedKey);
                if (allowed.indexOf(stored) >= 0) font = stored;
            } catch (err) {
                font = 'reader';
            }
            document.documentElement.dataset.font = font;
        })();
        (function() {
            try {
                if (localStorage.getItem('proseview-sidebar') === 'closed') {
                    document.documentElement.dataset.sidebar = 'closed';
                }
            } catch (err) {
                // Ignore storage errors and keep the default open state.
            }
        })();
    </script>
    <script src="/vendor/chart.js"></script>
    <script src="/vendor/chartjs-plugin-annotation.js"></script>
    <script src="/vendor/marked.js"></script>
    <style id="proseview-app-css">
{{ app_css | safe }}
    </style>
</head>
<body>
    <nav id="repoSidebar" class="repo-sidebar" aria-label="Repository files">
        <div class="sidebar-header">
            <span class="sidebar-title">Files</span>
            <div class="sidebar-header-actions">
                <div class="sidebar-create-wrap"><button id="sidebarCreateBtn" class="sidebar-chrome-btn" type="button" aria-label="Create a file or folder" aria-haspopup="menu" aria-controls="sidebarCreateMenu" aria-expanded="false" title="Create a file or folder">+</button><div id="sidebarCreateMenu" class="sidebar-action-menu sidebar-create-menu" role="menu" hidden><button type="button" role="menuitem" data-create-kind="file">New file</button><button type="button" role="menuitem" data-create-kind="folder">New folder</button></div></div>
                <button class="sidebar-close-btn" type="button" onclick="setSidebarOpen(false)" title="Close sidebar" aria-label="Close sidebar"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 7l10 10M17 7L7 17"></path></svg></button>
            </div>
        </div>
        <div id="sidebarTree" class="repo-tree sidebar-tree"></div>
        <div class="sidebar-resize-handle" id="sidebarResizeHandle" role="separator" tabindex="0" aria-label="Resize file browser" aria-orientation="vertical" aria-valuemin="160" aria-valuemax="520" aria-valuenow="280"></div>
    </nav>
    <div id="sidebarContextMenu" class="sidebar-action-menu sidebar-context-menu" role="menu" hidden></div>
    <dialog id="sidebarCreateDialog" class="sidebar-file-dialog" aria-labelledby="sidebarCreateTitle">
        <form id="sidebarCreateForm" method="dialog">
            <h2 id="sidebarCreateTitle">New file</h2>
            <label for="sidebarCreateName">Name</label>
            <input id="sidebarCreateName" name="name" type="text" maxlength="240" autocomplete="off" required>
            <label for="sidebarCreateLocation">Location</label>
            <select id="sidebarCreateLocation" name="parent"></select>
            <p id="sidebarCreatePreview" class="sidebar-dialog-preview"></p>
            <p id="sidebarCreateError" class="sidebar-dialog-error" role="alert" hidden></p>
            <div class="sidebar-dialog-actions"><button type="button" data-dialog-cancel>Cancel</button><button id="sidebarCreateConfirm" class="sidebar-dialog-primary" type="submit">Create</button></div>
        </form>
    </dialog>
    <dialog id="sidebarDeleteDialog" class="sidebar-file-dialog" aria-labelledby="sidebarDeleteTitle" aria-describedby="sidebarDeleteDescription">
        <form id="sidebarDeleteForm" method="dialog">
            <h2 id="sidebarDeleteTitle">Delete file?</h2>
            <p id="sidebarDeleteDescription"></p>
            <p class="sidebar-dialog-note">It will be moved to <code>.proseview/trash</code>, not permanently erased.</p>
            <p id="sidebarDeleteError" class="sidebar-dialog-error" role="alert" hidden></p>
            <div class="sidebar-dialog-actions"><button type="button" data-dialog-cancel>Cancel</button><button id="sidebarDeleteConfirm" class="sidebar-dialog-danger" type="submit">Delete</button></div>
        </form>
    </dialog>
    <div id="sidebarFileToast" class="sidebar-file-toast" role="status" aria-live="polite" hidden></div>

    <main id="mainContent">
    <header class="top-banner">
        <div class="dashboard-identity" style="display: flex; align-items: center; gap: 8px;"><div style="width: 28px; height: 28px; background-color: currentColor; -webkit-mask-image: url(data:image/png;base64,); -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center; mask-image: url(data:image/png;base64,); mask-size: contain; mask-repeat: no-repeat; mask-position: center;"></div><div><h1 style="margin-bottom: 2px;">Proseview</h1><span>Your manuscript at a glance</span></div></div>
        <div class="banner-stat"><span class="label">Total Words</span><span class="value">{{ total_words_text }} / <button type="button" style="background: none; border: none; padding: 0; color: inherit; font: inherit; cursor: pointer; text-decoration: underline; text-decoration-style: dotted; text-decoration-color: var(--text-muted);" onclick="showTab('settings')" title="Change goal in Settings">{{ target_words_text }}</button></span></div>
        <div class="banner-stat banner-progress"><span class="label">Goal Progress: {{ percent_target_text }}%</span><div class="range-bar" style="margin-top:8px;"><div class="target-zone" style="background:var(--banner-progress-fill); width:{{ percent_target_width }}%;"></div></div></div>
        <div class="banner-stat"><span class="label">Scenes</span><span class="value">{{ scene_count }}</span></div>
        <div class="banner-stat banner-finish"><span class="label">Est. Finish</span><span class="value">{{ days_to_finish }} days</span></div>
        {{ goals_banner_html | safe }}
    </header>

    <div class="app-toolbar">
        <nav class="tab-nav" aria-label="Dashboard sections">
            <button class="active" data-tab="overview" aria-current="page" onclick="showTab('overview')">Overview</button>
            <button data-tab="analysis" onclick="showTab('analysis')">Analysis</button>
            <button data-tab="timeline" onclick="showTab('timeline')">Timeline</button>
            <button data-tab="todos" onclick="showTab('todos')">TODOs</button>
            <button data-tab="notes" onclick="showTab('notes')">Notes</button>
            <button data-tab="settings" onclick="showTab('settings')">Settings</button>
        </nav>
        <div class="toolbar-actions">
            <button id="sidebarOpenBtn" class="sidebar-open-btn" onclick="setSidebarOpen(true)" title="Show file browser"><svg class="sidebar-chrome-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"></rect><path d="M9 4v16"></path></svg><span>Files</span></button>
            <div id="dashboardSearchMount" class="dashboard-search-mount">
                <div id="searchMenu" class="search-menu">
                    <div class="search-palette-header">
                        <div class="search-palette-header-copy"><strong id="searchPaletteTitle">Search repository</strong><span>Esc to close</span></div>
                        <button type="button" class="search-palette-close" onclick="_closeSearch()" aria-label="Close search" title="Close search">&times;</button>
                    </div>
                    <label class="sr-only" for="searchBox">Search scenes, files, tasks, and prose</label>
                    <input id="searchBox" class="search-box" type="text" placeholder="Search scenes, files, tasks, and prose…" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-controls="searchResults" aria-expanded="false">
                    <div id="searchNavigationWarning" class="search-navigation-warning" role="alert" hidden></div>
                    <div id="searchResults" class="search-results" role="listbox" aria-label="Search results" hidden></div>
                    <div id="searchStatus" class="sr-only" aria-live="polite"></div>
                </div>
            </div>
            <div id="fontMenu" class="font-menu">
                <button id="fontToggle" class="theme-toggle" type="button" onclick="toggleFontMenu()" aria-haspopup="listbox" aria-expanded="false" aria-label="Pick reading font">
                    <span class="theme-toggle-kicker">Font</span>
                    <span id="fontToggleLabel" class="theme-toggle-label">Reader</span>
                    <span class="font-menu-chevron" aria-hidden="true">&#9662;</span>
                </button>
                <ul id="fontMenuList" class="font-menu-list" role="listbox" aria-label="Reading font">
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="reader" onmouseenter="previewFont('reader')" onclick="selectFont('reader')">Reader</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="literary" onmouseenter="previewFont('literary')" onclick="selectFont('literary')">Literary</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="inter" onmouseenter="previewFont('inter')" onclick="selectFont('inter')">Inter</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="georgia" onmouseenter="previewFont('georgia')" onclick="selectFont('georgia')">Georgia</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="baskerville" onmouseenter="previewFont('baskerville')" onclick="selectFont('baskerville')">Baskerville</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="sans" onmouseenter="previewFont('sans')" onclick="selectFont('sans')">Sans</li>
                    <li class="font-menu-item" role="option" tabindex="-1" data-font-value="mono" onmouseenter="previewFont('mono')" onclick="selectFont('mono')">Mono</li>
                </ul>
            </div>
            <div id="themeMenu" class="theme-menu">
                <button id="themeToggle" class="theme-toggle" type="button" onclick="toggleThemeMenu()" aria-haspopup="listbox" aria-expanded="false" aria-label="Pick color theme">
                    <span class="theme-toggle-kicker">Theme</span>
                    <span id="themeToggleLabel" class="theme-toggle-label">Light</span>
                    <span class="font-menu-chevron" aria-hidden="true">&#9662;</span>
                </button>
                <ul id="themeMenuList" class="theme-menu-list" role="listbox" aria-label="Color theme">
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="light" onmouseenter="previewTheme('light')" onclick="selectTheme('light')">Light</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="dark" onmouseenter="previewTheme('dark')" onclick="selectTheme('dark')">Dark</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="docsify" onmouseenter="previewTheme('docsify')" onclick="selectTheme('docsify')">Docsify</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="hopscotch" onmouseenter="previewTheme('hopscotch')" onclick="selectTheme('hopscotch')">Hopscotch</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="graphite-light" onmouseenter="previewTheme('graphite-light')" onclick="selectTheme('graphite-light')">Graphite Light</li>
                    <li class="theme-menu-item" role="option" tabindex="-1" data-theme-value="graphite-dark" onmouseenter="previewTheme('graphite-dark')" onclick="selectTheme('graphite-dark')">Graphite Dark</li>
                </ul>
            </div>
        </div>
    </div>

    <div id="tab-overview" class="tab-panel active">
        <div class="dashboard-grid kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
            <div class="card kpi-card">
                <div class="kpi-label">Total Words</div>
                <div class="kpi-value" id="kpiTotalWords">--</div>
            </div>
            <div class="card kpi-card">
                <div class="kpi-label">Total Scenes</div>
                <div class="kpi-value" id="kpiTotalScenes">--</div>
            </div>
            <div class="card kpi-card">
                <div class="kpi-label">Reading Time</div>
                <div class="kpi-value" id="kpiReadingTime">--</div>
            </div>
            <div class="card kpi-card">
                <div class="kpi-label">Open TODOs</div>
                <div class="kpi-value" id="kpiOpenTodos">--</div>
            </div>
        </div>
        
        <div id="actionableInsightsSection" class="dashboard-grid" style="grid-template-columns: 1fr; margin-bottom: 24px; display: none;">
            <div class="card warning-card" style="border-color: var(--button-danger);">
                <div class="card-header"><h2 class="card-title" style="color: var(--button-danger);">Actionable Insights</h2></div>
                <ul id="actionableInsightsList" style="margin: 0; padding-left: 20px; line-height: 1.5;"></ul>
            </div>
        </div>

        {{ goals_card_wrapper | safe }}
        {{ recent_changes_card | safe }}



        <div class="card" style="padding:0; overflow:hidden;"><div class="card-header" style="margin:20px 24px;"><h2 class="card-title">Scenes</h2>
            <select id="issueFilter" class="issue-filter" onchange="applyIssueFilter()">
                <option value="all">All Scenes</option><option value="todos">Has TODOs</option><option value="notes">Has Notes</option><option disabled>──────</option><option value="status-draft">Status: Draft</option><option value="status-revision">Status: Revision</option><option value="status-done">Status: Done</option><option value="status-unknown">Status: Unknown</option>
            </select>
            <span class="section-note" style="margin-left:12px;">Prose metrics live in the <a href="#" onclick="showTab('analysis'); return false;">Analysis</a> tab.</span></div>
            <table id="sceneTable"><thead><tr><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(0)" aria-label="Sort by Scene">Scene</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(1)" aria-label="Sort by Chapter">Chapter</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(2)" aria-label="Sort by Words">Words</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortTable(3)" aria-label="Sort by Keywords" title="The 3 most distinctive words in this scene compared to the rest of the manuscript.">Keywords</button></th></tr></thead><tbody>
                {{ table_body | safe }}
            </tbody></table></div>
    </div>

    <div id="tab-analysis" class="tab-panel">
        <p id="analysisStatus" class="section-note" role="status" aria-live="polite">Preparing the analysis…</p>
        <div id="analysisContent" hidden>
            <div class="dashboard-grid">
                <figure class="card chart-figure" aria-labelledby="presenceChartTitle"><div class="card-header"><h2 class="card-title" id="presenceChartTitle">Character Presence Timeline</h2><p class="section-note" style="margin-top: 4px; margin-bottom: 0; line-height: 1.4;">Shows the pacing of character appearances throughout the manuscript by counting literal name mentions in each chapter. Use this to identify if a main character vanishes for long stretches.</p></div><div class="chart-frame"><canvas id="presenceChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
                <figure class="card chart-figure" aria-labelledby="locationChartTitle"><div class="card-header"><h2 class="card-title" id="locationChartTitle">Word Count per Location</h2><p class="section-note" style="margin-top: 4px; margin-bottom: 0; line-height: 1.4;">Shows which locations dominate the manuscript. Location data is read strictly from the <code>where:</code> or <code>location:</code> tags in each scene's frontmatter, or defaults to its parent folder name.</p></div><div class="chart-frame"><canvas id="locationChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
            </div>

            <div class="dashboard-grid" style="grid-template-columns: 1fr;">
                <figure class="card chart-figure" aria-labelledby="coOccurChartTitle"><div class="card-header"><h2 class="card-title" id="coOccurChartTitle">Character Co-Occurrence</h2><p class="section-note" style="margin-top: 4px; margin-bottom: 0; line-height: 1.4;">Shows which characters share the most "screen time" by counting the number of scenes where both are mentioned together. Use this to identify your strongest character pairings and isolated subplots.</p></div><div class="chart-frame"><canvas id="coOccurChart" aria-hidden="true"></canvas></div><div class="chart-data"></div></figure>
            </div>

            <div class="stats-layout" style="margin-bottom: 24px;">
                <section class="card"><div class="card-header"><h2 class="card-title">Book-Wide Lexical Health</h2></div>
                    <p class="section-note" style="margin-bottom: 24px; margin-top:0;">These metrics check if your vocabulary is rich and varied, or if you are over-repeating words.</p>

                    <div class="health-section" style="margin-bottom: 24px;">
                        <div style="font-size: 16px; margin-bottom: 4px; font-weight: 500; color: var(--text-primary);">Unique Words % (Local): <strong id="analysisMattrText" style="font-weight: 700;"></strong></div>
                        <p class="section-note" style="margin-top: 0; margin-bottom: 12px; line-height: 1.4;">Checks if you are echoing the same words too closely together. This explicitly tells you that, on average, <strong id="analysisMattrExplanationText"></strong> of your words in a local window are unique.<br><span style="opacity: 0.85;"><em>Example of a low score: "He opened the <b>door</b> and walked through the <b>door</b>, closing the <b>door</b>."</em></span></p>
                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--text-muted); font-weight: 500;">
                            <span>Repetitive</span>
                            <div class="range-bar" style="flex: 1;"><div class="target-zone" id="analysisMattrZone"></div><div class="current-marker" id="analysisMattrMarker"></div></div>
                            <span>Varied</span>
                        </div>
                    </div>

                    <div class="health-section">
                        <div style="font-size: 16px; margin-bottom: 4px; font-weight: 500; color: var(--text-primary);">Words Before Repetition (Scene): <strong id="analysisMtldText" style="font-weight: 700;"></strong></div>
                        <p class="section-note" style="margin-top: 0; margin-bottom: 12px; line-height: 1.4;">Checks the overall size of your vocabulary across a scene. This explicitly tells you that, on average, you write <strong id="analysisMtldExplanationText"></strong> before you start heavily repeating yourself.<br><span style="opacity: 0.85;"><em>Example of a low score: A 1,000 word dialogue scene where characters only say "Yes", "No", and "Okay".</em></span></p>
                        <div style="display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--text-muted); font-weight: 500;">
                            <span>Limited Vocab</span>
                            <div class="range-bar" style="flex: 1;"><div class="target-zone" id="analysisMtldZone"></div><div class="current-marker" id="analysisMtldMarker"></div></div>
                            <span>Rich Vocab</span>
                        </div>
                        <p class="health-refs" id="analysisMtldRefs"></p>
                    </div>
                </section>

                <figure class="card chart-figure" aria-labelledby="lexicalScatterChartTitle"><div class="card-header"><h2 class="card-title" id="lexicalScatterChartTitle">Lexical Health Map</h2></div>
                    <div class="section-note" style="margin-top: 4px; margin-bottom: 12px; line-height: 1.4;">
                        Plots every scene's vocabulary diversity. <strong>The green outlined box represents your Genre Target.</strong> Scenes falling below the green box are highly repetitive. Scenes inside or above the green box have excellent vocabulary range.
                    </div>
                    <div class="chart-frame-lg"><canvas id="lexicalScatterChart" aria-hidden="true"></canvas></div><div class="chart-data"></div>
                </figure>
            </div>


            <div class="dashboard-grid" style="grid-template-columns: 1fr;">
                <section class="card" style="padding:0; overflow:hidden;"><div class="card-header" style="margin:20px 24px;"><h2 class="card-title">Scene Deep Dive</h2>
                    <select id="analysisIssueFilter" class="issue-filter" onchange="applyAnalysisIssueFilter()">
                        <option value="all">All Scenes</option><option value="repetition">Repetitive</option><option value="clipped">Clipped</option><option value="talky">Talky</option><option value="dense">Dense</option><option value="todos">Has TODOs</option><option value="notes">Has Notes</option>
                    </select></div>
                    <table id="analysisSceneTable"><thead><tr><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(0)" aria-label="Sort by Scene">Scene</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(1)" aria-label="Sort by Chapter">Chapter</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(2)" aria-label="Sort by Words">Words</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(3)" aria-label="Sort by Lexical Health" title="Unique Words % (Local) and Words Before Repetition (Scene)">Lexical Health</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(4)" aria-label="Sort by Keywords" title="The 3 most distinctive words in this scene compared to the rest of the manuscript.">Keywords</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(5)" aria-label="Sort by Top Repeat">Top Repeat</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(6)" aria-label="Sort by Dialogue percent">Dialogue %</button></th><th aria-sort="none"><button type="button" class="table-sort-button" onclick="sortAnalysisTable(7)" aria-label="Sort by Sentence length" title="Average sentence length in words">Avg Sent Length</button></th></tr></thead><tbody id="analysisTableBody"></tbody></table></section>
            </div>
        </div>
    </div>

    <div id="tab-timeline" class="tab-panel">
        <div id="timelineContent"></div>
    </div>

    <div id="tab-todos" class="tab-panel">
        <div id="todosTabContent"></div>
    </div>

    <div id="tab-notes" class="tab-panel">
        <div class="notes-toolbar">
            <select id="notesTagFilter" class="notes-filter" onchange="filterNotes()">
                <option value="all">All Tags</option>
                <option value="note">Note</option>
                <option value="continuity">Continuity</option>
                <option value="character">Character</option>
                <option value="theme">Theme</option>
                <option value="question">Question</option>
            </select>
        </div>
        <div id="notesTabContent"></div>
    </div>

    <div id="tab-settings" class="tab-panel">
        <section class="card" style="max-width: 800px; margin: 0 auto; margin-top: 24px;">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <h2 class="card-title">Project Configuration</h2>
                    <p class="section-note" style="margin-top: 4px; margin-bottom: 0; line-height: 1.4;">
                        Proseview is configured entirely by a plain text file: <code>.proseview.yaml</code>. 
                        <br>You can edit these settings here, or 
                        {% if config_exists %}
                        <a href="{{ yaml_editor_url }}" class="editor-btn" style="color: var(--accent); text-decoration: none;">open the file in your editor</a>.
                        {% else %}
                        open the file in your editor.
                        {% endif %}
                    </p>
                </div>
                <button type="button" id="settingsSaveBtn" class="primary-button" onclick="saveSettings()" disabled style="margin-top: 4px;">Save Changes</button>
            </div>
            
            {% if not config_exists %}
            <div id="settingsEmptyBanner" style="margin: 0 24px; padding: 12px 16px; background: var(--surface-hover); border-radius: 6px; border-left: 3px solid var(--accent); font-size: 13px; color: var(--text-primary);">
                <strong>Proseview is currently using default settings.</strong> Change your Target Words or Daily Target below and save to create a <code>.proseview.yaml</code> file for your project.
            </div>
            {% endif %}
            
            <div class="settings-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; padding: 24px;">
                
                <div class="settings-group">
                    <h3 style="font-size: 14px; margin-bottom: 12px; color: var(--text-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">General Goals</h3>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;"><label style="color: var(--text-muted); font-size: 13px;">Target Words:</label> <input type="number" id="setting_target_words" class="inline-edit-input" value="{{ cfg.target_words }}" oninput="markSettingsDirty()"></div>
                        <div style="display: flex; justify-content: space-between; align-items: center;"><label style="color: var(--text-muted); font-size: 13px;">Daily Target:</label> <input type="number" id="setting_daily_target" class="inline-edit-input" value="{{ cfg.daily_target }}" oninput="markSettingsDirty()"></div>
                    </div>
                </div>

                <div class="settings-group">
                    <h3 style="font-size: 14px; margin-bottom: 12px; color: var(--text-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">Analysis Targets</h3>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;"><label style="color: var(--text-muted); font-size: 13px;">Genre Profile:</label> 
                            <select id="setting_genre" class="inline-edit-input" onchange="markSettingsDirty()">
                                <option value="contemporary" {% if cfg.genre == 'contemporary' %}selected{% endif %}>Commercial & contemporary</option>
                                <option value="childrens" {% if cfg.genre == 'childrens' %}selected{% endif %}>Children's / middle grade</option>
                                <option value="literary" {% if cfg.genre == 'literary' %}selected{% endif %}>Historical & literary</option>
                                <option value="speculative" {% if cfg.genre == 'speculative' %}selected{% endif %}>Fantasy & science fiction</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="settings-group">
                    <h3 style="font-size: 14px; margin-bottom: 12px; color: var(--text-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">Story Elements</h3>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted); font-size: 13px;">Characters:</span> <strong style="font-size: 13px;">{{ cfg.characters|length if cfg.characters else 'Auto-discovered' }}</strong></div>
                        <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-muted); font-size: 13px;">Locations:</span> <strong style="font-size: 13px;">{{ cfg.locations|length if cfg.locations else 'Auto-discovered' }}</strong></div>
                    </div>
                </div>

                <div class="settings-group">
                    <h3 style="font-size: 14px; margin-bottom: 12px; color: var(--text-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">Backup Management</h3>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <p class="section-note" style="margin-top: 0; margin-bottom: 8px; line-height: 1.4;">Proseview stores snapshots of your scenes locally to support undo/redo and file history.</p>
                        <div style="display: flex; justify-content: space-between; align-items: center;"><label style="color: var(--text-muted); font-size: 13px;">Total Backups Size:</label> <span id="setting_backup_size" style="font-size: 13px; color: var(--text-primary); font-variant-numeric: tabular-nums;">--</span></div>
                        <button type="button" class="editor-btn" onclick="clearAllBackups()" style="margin-top: 8px; align-self: flex-start; color: var(--red);">Clear All Backups...</button>
                    </div>
                </div>

            </div>
        </section>
    </div>

